{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "seed:cards": "ts-node ./scripts/seedCards.ts",
    "seed:solutions": "ts-node ./scripts/seedSolutionSets.ts",
    "seed:puzzles": "ts-node ./scripts/seedPuzzles.ts",
    "seed:daily": "ts-node ./scripts/seedDailyPuzzles.ts",
    "seed:all": "npm run seed:cards && npm run seed:solutions && npm run seed:puzzles",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.15.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
