# .env

# PostgreSQL Database Configuration
# Format - postgres://user:password@host:port/database
# Docker compose should have the DB service/host named "db" and the database "kogum_dev" created.
DATABASE_URL=postgres://postgres:postgrespassword@db:5432/kogum_dev
DATABASE_URL=postgres://kogum_db_user_here:kogum_db_password_here@db:5432/kogum_dev

# App Configuration
PORT=8080

# Security
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=YOUR_REALLY_SECRET_KEY_CHANGE_ME
JWT_EXPIRES_IN=3600
